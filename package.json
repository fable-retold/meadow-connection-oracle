{
    "name": "meadow-connection-oracle",
    "version": "1.0.1",
    "description": "Meadow Oracle Plugin",
    "main": "source/Meadow-Connection-Oracle.js",
    "scripts": {
        "coverage": "npx quack coverage",
        "test": "npx quack test",
        "docker-oracle-start": "bash ./start-oracle.sh",
        "docker-oracle-stop": "bash ./stop-oracle.sh",
        "test-docker": "bash ./start-oracle.sh && npm test; bash ./stop-oracle.sh",
        "start": "node source/Meadow-Connection-Oracle.js",
        "tests": "npx quack test -g",
        "build": "npx quack build"
    },
    "mocha": {
        "diff": true,
        "extension": [
            "js"
        ],
        "package": "./package.json",
        "reporter": "spec",
        "slow": "75",
        "timeout": "5000",
        "ui": "tdd",
        "watch-files": [
            "source/**/*.js",
            "test/**/*.js"
        ],
        "watch-ignore": [
            "lib/vendor"
        ]
    },
    "repository": {
        "type": "git",
        "url": "https://github.com/fable-retold/meadow-connection-oracle.git"
    },
    "keywords": [
        "meadow",
        "oracle",
        "retold"
    ],
    "author": "Steven Velozo <steven@velozo.com> (http://velozo.com/)",
    "license": "MIT",
    "bugs": {
        "url": "https://github.com/fable-retold/meadow-connection-oracle/issues"
    },
    "homepage": "https://github.com/fable-retold/meadow-connection-oracle",
    "devDependencies": {
        "fable": "^3.1.75",
        "pict-docuserve": "^1.4.12",
        "quackage": "^1.3.0"
    },
    "dependencies": {
        "fable-serviceproviderbase": "^3.0.19",
        "oracledb": "^6.10.0"
    }
}
